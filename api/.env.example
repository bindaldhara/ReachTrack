DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PORT=8080
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Gmail OAuth (optional — required for Profile → Connect Gmail)
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/v1/integrations/gmail/callback
WEB_APP_URL=http://localhost:5173
OAUTH_STATE_SECRET=

# Days without a company reply before first-touch mail shows as follow-up due (default 1)
FOLLOW_UP_DUE_DAYS=1
# Gmail import timeout in seconds (default 600)
GMAIL_SYNC_TIMEOUT_SECONDS=600

# Optional — AI rejection detection (OpenRouter preferred; then Gemini, OpenAI, rules)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


